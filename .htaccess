Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jangan pernah layani source, tooling, dokumentasi internal, atau skema DB.
    RewriteRule ^(application|system|docs|database|tools)(/|$) - [R=404,L,NC]
    RewriteRule ^(app-manifest\.json|README\.md|INSTALL\.md|penatus\.sql)$ - [R=404,L,NC]
    RewriteRule ^setup(?:/|$) - [R=404,L,NC]
    RewriteRule \.(?:sql|sqlite3?|dump|bak|backup|log|ini)$ - [R=404,L,NC]

    # Izinkan akses langsung ke folder assets & file statis
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<FilesMatch "^(?:\.env|\.git|\.htaccess|\.user\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>
